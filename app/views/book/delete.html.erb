<%= link_to("Back to Home", root_path, class: 'back-link') %>

<div class = "book delete">
    <h2>Delete Books</h2>

    <%= form_for(@book) do |f| %>
        <% #url: task_path(@task), method: 'delete' %>

        <p>Are you sure you want to permanently delete this book?</p>
        <p><%= @book.title %></p>

        <div class = "form-buttons">
            <%= f.submit("Delete Book") %>
        </div>

    <% end %>
</div>