
<div class="books index">
  <p style="color: green"><%= notice %></p>
<h1>Books</h1>
<h1>This is the authenticated version 2</h1>
<h1>You're logged in! Welcome to the Dashboard!</h1>
<%= link_to "Sign Out", destroy_admin_session_path %>

  <%= link_to("Add New Book", new_book_path, class: 'action new') %>

  <% if flash[:notice] %>
  <div class="popup">
    <%= flash[:notice] %>
  </div>
<% end %>


<table>
  <tr>
    <th>Title</th>
    <th>Author</th>
    <th>Price</th>
    <th>Published Date</th>
    <th>Actions</th>
  </tr>

  <% @books.each do |book| %>
    <tr>
      <td><%= book.title %></td>
      <td><%= book.author %></td>
      <td><%= book.price %></td>
      <td><%= book.published_date %></td>
      <td>
        <%= link_to("Show", book_path(book)) %>
        <%= link_to("Edit", edit_book_path(book)) %>
        <%= link_to("Delete", delete_book_path(book)) %>
      </td>
    </tr>
  <% end %>
</table>


</div>
